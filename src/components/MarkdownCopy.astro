---
type Props = {
  markdownUrl: string
  compact?: boolean
}

const { markdownUrl, compact = false } = Astro.props
---

<div class:list={["markdown-copy", { compact }]} data-markdown-copy>
  <button type="button" class="btn-ghost" data-markdown-copy-button data-markdown-url={markdownUrl}>Copy as Markdown</button>
  <a href={markdownUrl} type="text/markdown" class="markdown-copy-link">Open Markdown</a>
  <span class="sr-only" data-markdown-copy-status aria-live="polite"></span>
</div>

<script>
  import "../scripts/markdownCopy"
</script>

<style>
  .markdown-copy { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); font-family: var(--font-sans); }
  .markdown-copy-link { font-size: 0.875rem; font-weight: 600; }
  .compact { gap: var(--space-2); }
  .compact :global(.btn-ghost) { min-height: auto; padding: var(--space-1) var(--space-2); font-size: 0.8125rem; }
  .compact .markdown-copy-link { font-size: 0.8125rem; }
</style>
