---
import type { CollectionEntry } from "astro:content";
import { format } from "date-fns";
import BookRating from "./BookRating.astro";
import Link from "./Link.astro";
import TagsList from "./TagsList.astro";
import { getAddedDate } from "../utils/library";

type Props = {
  book: CollectionEntry<"books">;
};

const { book: book } = Astro.props;

const url = `/books/${book.id}/`;
const title = book.data.title;
const date = getAddedDate(book.data.dateAdded);
const tags = book.data.tags;
const rating = book.data.myRating;
---

<li>
  <div>
    <Link href={url} transition:name={`title-${book.id}`}>
      {title}
    </Link>

    <BookRating {rating} />

    <time
      class="ml-2 text-sm whitespace-nowrap text-muted-foreground"
      >{date ? format(date, "MMMM dd, yyyy") : "Date unknown"}
    </time>
  </div>

  <TagsList collection="books" tags={tags} />
</li>
