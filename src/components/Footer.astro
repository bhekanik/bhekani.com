---
const year = new Date().getFullYear()

const groups = [
  {
    title: "Site",
    links: [
      { label: "About", href: "/about" },
      { label: "Blog", href: "/posts" },
      { label: "Micro", href: "/micro" },
      { label: "Projects", href: "/projects" },
      { label: "Books", href: "/books" },
      { label: "Unoffice hours", href: "/unoffice-hours" },
      { label: "Colophon", href: "/colophon" },
    ],
  },
  {
    title: "Building",
    links: [
      { label: "mxr", href: "https://mxr.sh" },
      { label: "FaithBench", href: "https://faithbench.com/" },
      { label: "blah.chat", href: "https://blah.chat/" },
      { label: "CV Optimiser", href: "https://www.cvoptimiser.com" },
    ],
  },
  {
    title: "Elsewhere",
    links: [
      { label: "GitHub", href: "https://github.com/bhekanik", rel: "me" },
      { label: "Twitter", href: "https://twitter.com/bhekanik" },
      { label: "LinkedIn", href: "https://linkedin.com/in/bhekanik" },
      { label: "Newsletter", href: "https://justreflections.bhekani.com" },
      { label: "Digital Garden", href: "https://digitalgarden.bhekani.com" },
      { label: "RSS", href: "/rss.xml" },
    ],
  },
]
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="brand">
      <p class="wordmark">Bhekani Khumalo</p>
      <p class="blurb">
        Software engineer in London. Workflows at Contentful, part-time CPO at Notto, indie products in the gaps. Writes about all of it.
      </p>
    </div>

    {
      groups.map((group) => (
        <div class="group">
          <h2>{group.title}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href} rel={link.rel}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="site-footer-bottom">
    <p>© {year} Bhekani Khumalo</p>
    <p>Built with Astro. Hosted on Vercel.</p>
  </div>
</footer>

<style>
  .site-footer {
    grid-area: footer;
    margin-top: var(--space-16);
    border-top: 1px solid var(--border);
    background: var(--card);
  }

  .site-footer-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-10) var(--space-8);
    max-width: 80rem;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
  }

  .brand {
    grid-column: 1 / -1;
    max-width: 34ch;
  }

  .wordmark {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: "wdth" 120;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .blurb {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--muted-foreground);
  }

  .group h2 {
    margin: 0 0 var(--space-3);
    font-size: 0.8125rem;
    font-weight: 600;
    font-variation-settings: "wdth" 100;
    letter-spacing: 0;
    color: var(--foreground);
  }

  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.375rem;
  }

  .group a {
    font-size: 0.9375rem;
    color: var(--muted-foreground);
    text-decoration: none;
  }
  .group a:hover {
    color: var(--links);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .site-footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    max-width: 80rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-8);
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }
  .site-footer-bottom p {
    margin: 0;
  }

  @media (min-width: 64rem) {
    .site-footer-inner {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
    .brand {
      grid-column: auto;
    }
  }
</style>
