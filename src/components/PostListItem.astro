---
import type { CollectionEntry } from "astro:content"
import Link from "./Link.astro"
import PostDescription from "./PostDescription.astro"
import TagsList from "./TagsList.astro"
import { formatPostDateUtc } from "../utils/articleReading"

type Props = {
  post: CollectionEntry<"posts">
}

const { post: post } = Astro.props

const url = `/posts/${post.id}/`
const title = post.data.title
const date = post.data.pubDate
const tags = post.data.tags
---

<li>
  <div>
    <Link href={url} transition:name={`title-${post.id}`}>
      {title}
    </Link>

    <time
      class="ml-2 text-sm whitespace-nowrap text-muted-foreground"
       >{formatPostDateUtc(date)}
    </time>
  </div>

  <PostDescription description={post.data.description} slug={post.id} />

  <TagsList tags={tags} />
</li>
