---
import FeedbackToggle from "./FeedbackToggle.astro"
import Search from "./Search.svelte"
import SkinSwitcher from "./SkinSwitcher.astro"
import ThemeIcon from "./ThemeIcon.astro"

const navItems = [
  { title: "About", href: "/about" },
  { title: "Blog", href: "/posts" },
  { title: "Micro", href: "/micro" },
  { title: "Projects", href: "/projects" },
  { title: "Books", href: "/books" },
  { title: "Unoffice hours", href: "/unoffice-hours" },
]

const section = Astro.url.pathname.split("/")[1]
const isActive = (href: string) => href.split("/")[1] === section
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="logo" aria-label="Bhekani Khumalo, home">BK</a>

    <nav class="primary-nav" aria-label="Primary">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.title}
          </a>
        ))
      }
    </nav>

    <div class="controls">
      <button type="button" class="icon-btn search-trigger" aria-label="Search" title="Search (⌘K)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
      </button>
      <FeedbackToggle />
      <ThemeIcon />
      <SkinSwitcher />
      <button
        type="button"
        class="icon-btn menu-button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Primary, mobile">
      <a href="/" aria-current={section === "" ? "page" : undefined}>Home</a>
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.title}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<Search client:load />

<script>
  document.addEventListener("astro:page-load", () => {
    const button = document.querySelector<HTMLButtonElement>(".menu-button")
    const menu = document.getElementById("mobile-menu") as HTMLElement | null
    if (!button || !menu) return

    const setOpen = (open: boolean) => {
      menu.hidden = !open
      button.setAttribute("aria-expanded", String(open))
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu")
    }

    button.addEventListener("click", () => setOpen(menu.hasAttribute("hidden")))
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)))
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hasAttribute("hidden")) {
        setOpen(false)
        button.focus()
      }
    })
  })
</script>

<style>
  .site-header {
    grid-area: header;
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--background);
    border-bottom: var(--rule) solid var(--border);
  }
  :global(html[data-skin="route"]) .site-header {
    background: color-mix(in oklch, var(--background) 85%, transparent);
    backdrop-filter: blur(8px);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    max-width: 74rem;
    height: 4rem;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* Logo: a red stamp, slightly askew, like a cover price box */
  .logo {
    display: inline-grid;
    place-items: center;
    height: 2.25rem;
    padding: 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: 0.02em;
    color: var(--accent-foreground);
    background: var(--accent);
    border: var(--rule) solid var(--border);
    box-shadow: var(--shadow-ink-sm);
    text-decoration: none;
    transform: rotate(-2deg);
    transition: transform var(--transition-fast);
  }
  .logo:hover {
    color: var(--accent-foreground);
    transform: rotate(2deg);
  }
  :global(html[data-skin="route"]) .logo {
    transform: none;
    border: 0;
    border-radius: 50%;
    width: 2.25rem;
    padding: 0;
    font-size: 0.9375rem;
    font-weight: 800;
  }
  :global(html[data-skin="route"]) .logo:hover {
    transform: none;
  }

  .primary-nav {
    display: none;
    align-items: center;
    gap: var(--space-1);
    margin-right: auto;
  }

  .primary-nav a,
  .mobile-menu a {
    padding: 0.375rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--foreground);
    text-decoration: none;
    border: 2px solid transparent;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }
  .primary-nav a:hover {
    background: var(--muted);
  }
  .primary-nav a[aria-current="page"] {
    background: var(--highlight);
    color: var(--highlight-foreground);
    border-color: var(--border);
  }
  :global(html[data-skin="route"]) .primary-nav a,
  :global(html[data-skin="route"]) .mobile-menu a {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted-foreground);
  }
  :global(html[data-skin="route"]) .primary-nav a:hover {
    color: var(--foreground);
    background: transparent;
  }
  :global(html[data-skin="route"]) .primary-nav a[aria-current="page"] {
    background: transparent;
    color: var(--foreground);
    border-color: transparent;
    border-bottom-color: var(--accent);
    border-bottom-width: 3px;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
  }

  .mobile-menu {
    border-top: var(--rule) solid var(--border);
    padding: var(--space-3) var(--space-6) var(--space-4);
    background: var(--background);
  }
  .mobile-menu nav {
    display: grid;
    gap: var(--space-1);
    max-width: 74rem;
    margin: 0 auto;
  }
  .mobile-menu a {
    font-size: 1rem;
    padding: 0.625rem 0.75rem;
  }
  .mobile-menu a[aria-current="page"] {
    background: var(--highlight);
    color: var(--highlight-foreground);
    border-color: var(--border);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) {
      animation: rise 0.25s var(--ease-out-quart) both;
    }
  }

  @media (min-width: 56rem) {
    .primary-nav {
      display: flex;
    }
    .menu-button,
    .mobile-menu {
      display: none;
    }
  }
</style>
