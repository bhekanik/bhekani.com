<div data-giscus-container class="mt-8"></div>

<script>
  import { initializeGiscus } from "../utils/giscus"

  type GiscusWindow = Window & {
    giscusCleanup?: () => void
  }

  const giscusWindow = window as GiscusWindow

  const initialize = () => {
    giscusWindow.giscusCleanup?.()
    giscusWindow.giscusCleanup = initializeGiscus()
  }

  document.addEventListener("astro:page-load", initialize)
  document.addEventListener("astro:before-swap", () => {
    giscusWindow.giscusCleanup?.()
    giscusWindow.giscusCleanup = undefined
  })
</script>
