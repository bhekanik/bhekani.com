---

---

<button id="themeToggle" class="icon-btn" type="button" aria-label="Switch to light theme" data-feedback="toggle">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <g class="sun">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </g>
    <path class="moon" d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z" />
  </svg>
</button>

<style>
  .sun,
  .moon {
    transform-origin: 12px 12px;
    transition:
      opacity var(--transition-base),
      transform var(--transition-slow);
  }
  .sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  .moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  :global(.dark) .sun {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  :global(.dark) .moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
</style>

<script>
  import { feedback } from "../scripts/feedback"
  import { bindPreferenceOnce, getTheme, renderOnPageLoad, setTheme } from "../scripts/preferences"

  function syncLabel() {
    const button = document.getElementById("themeToggle")
    button?.setAttribute("aria-label", getTheme() === "dark" ? "Switch to light theme" : "Switch to dark theme")
  }

  function applyTheme(theme: "light" | "dark") {
    setTheme(theme)
    syncLabel()

    // Giscus listens for a postMessage rather than reloading the iframe
    const giscus = document.querySelector<HTMLIFrameElement>("iframe.giscus-frame")
    giscus?.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, "https://giscus.app")
  }

  function toggleTheme() {
    const next = getTheme() === "dark" ? "light" : "dark"
    feedback.play("tock")
    feedback.haptic("tap")

    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
    if (!reduced && "startViewTransition" in document) {
      document.startViewTransition(() => applyTheme(next))
    } else {
      applyTheme(next)
    }
  }

  renderOnPageLoad("theme-toggle", syncLabel)
  bindPreferenceOnce("theme-toggle", () => {
    document.addEventListener("click", (event) => {
      const target = event.target
      if (target instanceof Element && target.closest("#themeToggle")) toggleTheme()
    })
  })
</script>
