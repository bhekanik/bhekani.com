---
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import { format } from "date-fns"
import AllTags from "../components/AllTags.astro"
import MainContainer from "../components/MainContainer.astro"
import BK from "../images/BK.webp"
import BaseLayout from "../layouts/BaseLayout.astro"

const pageTitle = "Bhekani Khumalo"
const issue = new Date().getFullYear()

const featured = (await getCollection("projects"))
  .filter((project) => project.data.published && project.data.featured)
  .sort((a, b) => new Date(b.data.startDate).valueOf() - new Date(a.data.startDate).valueOf())

const posts = (await getCollection("posts"))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4)
---

<BaseLayout pageTitle={pageTitle} imageUrl="https://www.bhekani.com/og/homepage.png" hidePageHeader={true}>
  <MainContainer>
    <div class="page">
      <section class="panel dots splash land" style="--i: 0">
        <span class="cap">Meanwhile, in London…</span>
        <h1>Bhekani<br /><em>Khumalo</em></h1>
        <p class="lede">
          Software engineer. Workflows at <a href="https://contentful.com/">Contentful</a> by day, part-time CPO at <a href="https://nottoafrica.com">Notto</a>, indie products in the gaps. Civil engineer in a previous issue.
        </p>
        <p class="actions">
          <a href="/posts" class="btn">Read the blog</a>
          <a href="/unoffice-hours" class="btn-ghost">Book a call</a>
        </p>
      </section>

      <section class="panel portrait land" style="--i: 1" aria-label="Portrait">
        <span class="burst">Issue #{issue}</span>
        <div class="halftone">
          <Image src={BK} alt="Bhekani Khumalo" width={640} height={640} loading="eager" />
        </div>
      </section>

      <section class="panel building land" style="--i: 2">
        <span class="cap">Currently building</span>
        <div class="strip">
          {
            featured.map((project) => (
              <a href={project.data.url} class="feature">
                {project.data.image && (
                  <Image src={project.data.image} alt={`Screenshot of ${project.data.title}`} width={640} height={400} loading="lazy" />
                )}
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
              </a>
            ))
          }
        </div>
        <a class="more link-quiet" href="/projects/">All projects →</a>
      </section>

      <section class="panel writing land" style="--i: 3">
        <span class="cap">Recent writing</span>
        <ol class="posts">
          {
            posts.map((post, index) => (
              <li>
                <span class="n" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <a href={`/posts/${post.id}/`} class="post-title" transition:name={`title-${post.id}`}>
                    {post.data.title}
                  </a>
                  <time class="meta" datetime={post.data.pubDate.toISOString()}>
                    {format(post.data.pubDate, "d MMM yyyy")}
                  </time>
                </div>
              </li>
            ))
          }
        </ol>
        <a class="more link-quiet" href="/posts/">All posts →</a>
      </section>

      <aside class="bubble newsletter land" style="--i: 4">
        <h2>Just Reflections</h2>
        <p>A newsletter on software, building products, and life outside tech. Goes out when I have something worth saying, not on a schedule.</p>
        <a href="https://justreflections.bhekani.com/" target="_blank" rel="noopener" class="btn">Subscribe</a>
      </aside>

      <section class="tags land" style="--i: 5">
        <AllTags />
      </section>
    </div>
  </MainContainer>
</BaseLayout>

<style>
  .page {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-4);
    padding-top: var(--space-8);
  }
  .page > * {
    grid-column: 1 / -1;
  }

  .splash {
    min-height: 28rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-12) var(--space-6) var(--space-6);
    background-image: linear-gradient(transparent 0 55%, var(--card) 100%), var(--halftone);
  }
  .splash h1 {
    font-size: clamp(3.5rem, 2rem + 8vw, 8rem);
    line-height: 0.9;
    margin: 0 0 var(--space-4);
  }
  .splash h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .lede {
    max-width: 46ch;
    font-size: 1.2rem;
    margin: 0 0 var(--space-6);
    padding: var(--space-1) 0;
    background: var(--card);
    box-shadow: 0 0 0 6px var(--card);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
  }

  .portrait {
    padding: 0;
    overflow: hidden;
    background: var(--spot);
    min-height: 22rem;
  }
  .portrait .burst {
    position: absolute;
    top: -1.25rem;
    right: -1rem;
    z-index: 1;
  }
  :global(html[data-skin="route"]) .portrait .burst {
    top: var(--space-3);
    right: var(--space-3);
  }
  /* CSS halftone: greyscale photo, hard contrast, dot screen multiplied on top */
  .halftone {
    position: relative;
    height: 100%;
    min-height: 22rem;
  }
  .halftone img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(1) contrast(1.25) brightness(1.05);
    mix-blend-mode: multiply;
  }
  .halftone::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--halftone);
    background-size: 5px 5px;
    opacity: 0.55;
    pointer-events: none;
  }
  :global(html[data-skin="route"]) .halftone img {
    filter: none;
    mix-blend-mode: normal;
  }
  :global(html[data-skin="route"]) .portrait {
    background: var(--card);
  }

  .building {
    padding: var(--space-8) 0 var(--space-6);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .feature {
    display: block;
    padding: var(--space-5);
    color: var(--foreground);
    text-decoration: none;
    border-right: var(--rule) solid var(--border);
  }
  .feature:last-child {
    border-right: 0;
  }
  .feature img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: var(--rule) solid var(--border);
    margin-bottom: var(--space-4);
    transition: transform var(--transition-fast);
  }
  .feature:hover img {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-ink-sm);
  }
  .feature h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.75rem;
  }
  .feature:hover h3 {
    color: var(--links);
  }
  .feature p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .building .more {
    margin: var(--space-4) var(--space-5) 0;
  }

  .writing {
    padding-top: var(--space-10);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posts li {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-4) 0;
    border-top: var(--rule) solid var(--border);
  }
  .posts .n {
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 0.85;
    color: var(--accent);
  }
  .post-title {
    display: block;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--foreground);
    text-decoration: none;
    margin-bottom: 0.25rem;
  }
  .post-title:hover {
    color: var(--links);
  }

  .more {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-foreground);
  }

  .newsletter {
    align-self: start;
    margin-bottom: var(--space-8);
  }
  .newsletter h2 {
    margin: 0 0 var(--space-2);
  }
  .newsletter p {
    margin: 0 0 var(--space-5);
    font-size: 0.9375rem;
  }

  .tags {
    padding-top: var(--space-4);
  }

  @media (min-width: 48rem) {
    .page {
      gap: var(--space-5);
    }
    .page .splash {
      grid-column: 1 / 5;
    }
    .page .portrait {
      grid-column: 5 / 7;
      min-height: 0;
    }
    .page .writing {
      grid-column: 1 / 5;
    }
    .page .newsletter {
      grid-column: 5 / 7;
      margin-top: var(--space-10);
    }
  }
  @media (max-width: 48rem) {
    .strip {
      grid-template-columns: 1fr;
    }
    .feature {
      border-right: 0;
      border-bottom: var(--rule) solid var(--border);
    }
    .feature:last-child {
      border-bottom: 0;
    }
  }
</style>
