---
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import { format } from "date-fns"
import AllTags from "../components/AllTags.astro"
import MainContainer from "../components/MainContainer.astro"
import BK from "../images/BK.webp"
import BaseLayout from "../layouts/BaseLayout.astro"

const pageTitle = "Bhekani Khumalo"

const featured = (await getCollection("projects"))
  .filter((project) => project.data.published && project.data.featured)
  .sort((a, b) => new Date(b.data.startDate).valueOf() - new Date(a.data.startDate).valueOf())

const posts = (await getCollection("posts"))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5)
---

<BaseLayout pageTitle={pageTitle} imageUrl="https://www.bhekani.com/og/homepage.png" hidePageHeader={true}>
  <MainContainer>
    <section class="hero rise">
      <div class="hero-text">
        <h1>Bhekani<br />Khumalo</h1>
        <p class="lede">
          Software engineer in London. I lead the Workflows engineering at <a href="https://contentful.com/">Contentful</a>, after a year building the semantic layer behind its AI features. Part-time CPO at Notto. Civil engineer before any of it. I ship indie products in the gaps.
        </p>
        <p class="hero-links">
          <a href="/about" class="btn">About me</a>
          <a href="/posts" class="btn-ghost">Read the blog</a>
          <a href="/unoffice-hours" class="btn-ghost">Book a call</a>
        </p>
      </div>
      <div class="portrait">
        <Image src={BK} alt="Bhekani Khumalo" width={320} height={320} loading="eager" />
      </div>
    </section>

    <section class="building">
      <h2>Currently building</h2>
      <div class="features">
        {
          featured.map((project) => (
            <a href={project.data.url} class="feature">
              {project.data.image && (
                <Image src={project.data.image} alt={`Screenshot of ${project.data.title}`} width={640} height={400} loading="lazy" />
              )}
              <span class="feature-title">{project.data.title}</span>
              <span class="feature-desc">{project.data.description}</span>
            </a>
          ))
        }
      </div>
      <a class="more link-quiet" href="/projects/">All projects →</a>
    </section>

    <section class="writing">
      <h2>Recent writing</h2>
      <ul class="rule-list">
        {
          posts.map((post) => (
            <li>
              <a href={`/posts/${post.id}/`} class="post-title" transition:name={`title-${post.id}`}>
                {post.data.title}
              </a>
              <time class="meta" datetime={post.data.pubDate.toISOString()}>
                {format(post.data.pubDate, "d MMM yyyy")}
              </time>
              {post.data.description && <p>{post.data.description}</p>}
            </li>
          ))
        }
      </ul>
      <a class="more link-quiet" href="/posts/">All posts →</a>
    </section>

    <AllTags />

    <section class="newsletter">
      <div>
        <h2>Just Reflections</h2>
        <p>
          A newsletter on software, building products, and life outside tech. Goes out when I have something worth saying, not on a schedule.
        </p>
      </div>
      <a href="https://justreflections.bhekani.com/" target="_blank" rel="noopener" class="btn newsletter-btn">Subscribe</a>
    </section>
  </MainContainer>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: end;
    padding: var(--space-12) 0 var(--space-10);
  }

  .hero h1 {
    font-size: clamp(3rem, 2rem + 5vw, 5.5rem);
    line-height: 0.95;
    margin: 0 0 var(--space-6);
  }

  .lede {
    font-size: 1.25rem;
    line-height: 1.55;
    max-width: 42ch;
    margin: 0 0 var(--space-8);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
  }

  /* Offset oxide slab behind the portrait: the one decorative move on the page */
  .portrait {
    position: relative;
    width: min(16rem, 60vw);
    justify-self: start;
  }
  .portrait::before {
    content: "";
    position: absolute;
    inset: 0;
    translate: 0.875rem 0.875rem;
    background: var(--accent);
    border-radius: var(--radius-lg);
  }
  .portrait img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  section + section {
    margin-top: var(--space-16);
  }

  section h2 {
    margin: 0 0 var(--space-6);
  }

  .rule-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .rule-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-4);
    padding: var(--space-4) 0;
  }
  .rule-list p {
    grid-column: 1 / -1;
    margin: var(--space-1) 0 0;
    color: var(--muted-foreground);
    font-size: 1rem;
  }

  .features {
    display: grid;
    gap: var(--space-8) var(--space-6);
  }
  .feature {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    color: var(--foreground);
    text-decoration: none;
  }
  .feature img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    transition: border-color var(--transition-fast);
  }
  .feature:hover img {
    border-color: var(--accent);
  }
  .feature-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-variation-settings: "wdth" 105;
    font-size: 1.125rem;
  }
  .feature:hover .feature-title {
    color: var(--links);
  }
  .feature-desc {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-name,
  .post-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-variation-settings: "wdth" 105;
    font-size: 1.125rem;
    color: var(--foreground);
    text-decoration: none;
  }
  .project-name:hover,
  .post-title:hover {
    color: var(--links);
  }

  .more {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .newsletter {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
    background: var(--accent);
    color: var(--accent-foreground);
    border-radius: var(--radius-xl);
  }
  .newsletter h2 {
    margin: 0 0 var(--space-2);
    color: inherit;
  }
  .newsletter p {
    margin: 0;
    max-width: 48ch;
    color: inherit;
  }
  .newsletter-btn {
    align-self: end;
    justify-self: start;
    background: var(--accent-foreground);
    color: var(--accent);
  }
  .newsletter-btn:hover {
    background: var(--accent-foreground);
    color: var(--accent);
    opacity: 0.92;
  }

  @media (min-width: 40rem) {
    .features {
      grid-template-columns: repeat(3, 1fr);
    }
    .hero {
      grid-template-columns: 1fr auto;
    }
    .portrait {
      justify-self: end;
      margin-bottom: var(--space-2);
    }
    .newsletter {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
