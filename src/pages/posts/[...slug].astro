---
import { Image } from "astro:assets"
import { getCollection, render, type CollectionEntry } from "astro:content"
import Giscuss from "../../components/Giscuss.astro"
import Link from "../../components/Link.astro"
import MainContainer from "../../components/MainContainer.astro"
import MarkdownCopy from "../../components/MarkdownCopy.astro"
import Prose from "../../components/Prose.astro"
import SocialInteractions from "../../components/SocialInteractions.astro"
import TableOfContents from "../../components/TableOfContents.astro"
import ViewCounter from "../../components/ViewCounter.svelte"
import WebMentions from "../../components/WebMentions.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { formatPostDateUtc } from "../../utils/articleReading"

export async function getStaticPaths() {
  const posts = await getCollection("posts")
  return posts.filter((post) => post.data.published).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

type Props = {
  post: CollectionEntry<"posts">
}

const { post } = Astro.props
const { Content, headings } = await render(post)

const wordCount = post.body?.split(/\s+/).length ?? 0
const readingTime = Math.max(1, Math.round(wordCount / 200))
const publishedDate = formatPostDateUtc(post.data.pubDate)
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const hasContents = tocHeadings.length >= 3
---

<BaseLayout
  pageTitle={post.data.title}
  description={post.data.description}
  imageUrl={`https://www.bhekani.com/posts/${post.id}.png`}
  hidePageHeader={true}
>
  {/* Reading Progress Bar */}
  <div id="reading-progress" class="fixed top-0 left-0 h-0.5 z-50" style="width: 0%"></div>

  <MainContainer>
    <article class="article-reading mx-auto mt-6" data-article-reading>
      {/* Article Header */}
      <header class="article-header post-animate-header panel dots">
        <span class="cap">Published {publishedDate}</span>
        <div class="article-header-content">
          <div class="article-meta text-sm text-muted-foreground">
            <Link href="/posts" class="hover:text-foreground">
              ← Back to posts
            </Link>
            <time datetime={post.data.pubDate.toISOString()}>
              {publishedDate}
            </time>
            <span>{readingTime} min read</span>
          </div>

          <h1>{post.data.title}</h1>

          {
            post.data.description && (
              <p class="text-xl text-muted-foreground max-w-[60ch] font-body">
                {post.data.description}
              </p>
            )
          }

          {
            post.data.tags && (
              <div class="article-tags flex flex-wrap gap-4">
                {post.data.tags.map((tag: string) => (
                  <a
                    href={`/posts/tags/${tag}`}
                    class="tag"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }
          <MarkdownCopy markdownUrl={`/posts/${post.id}.md`} />
        </div>

        {
          post.data.image && (
            <div class="article-hero">
              <Image
                src={post.data.image}
                alt={post.data.imageAlt ?? ""}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1280px) 72rem, (min-width: 768px) 80vw, calc(100vw - 3rem)"
                class="h-full w-full object-cover"
                loading="eager"
              />
            </div>
          )
        }
      </header>

      {
        hasContents && (
          <details class="article-contents" data-article-contents>
            <summary>Contents</summary>
            <nav aria-label="Contents">
              <TableOfContents headings={tocHeadings} />
            </nav>
          </details>
        )
      }

      {/* Main Content */}
      <div class:list={["article-body-layout", { "has-contents": hasContents }]}>
        <div class="post-animate-content article-body" data-reading-body>
          <Prose>
            <Content />
          </Prose>
        </div>
        {
          hasContents && (
            <aside class="article-contents-rail" aria-label="Contents">
              <p class="meta mb-3">Contents</p>
              <TableOfContents headings={tocHeadings} />
            </aside>
          )
        }
      </div>

      {/* Article Footer */}
      <footer class="post-animate-footer mt-16 pt-8">
        {/* Share Section */}
        <div class="mb-16 space-y-4">
          <h2 class="text-lg font-semibold">Share this post</h2>
          <div class="flex gap-4">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`https://www.bhekani.com/posts/${post.id}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
            >
              Share on Twitter
            </a>
            <a
              href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(`https://www.bhekani.com/posts/${post.id}`)}&title=${encodeURIComponent(post.data.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
            >
              Share on LinkedIn
            </a>
          </div>
          <div class="article-views">
            <ViewCounter client:load slug={post.id} />
          </div>
        </div>

        <div class="border-t border-muted">
          {/* Webmentions */}
          <div class="my-16">
            <WebMentions />
          </div>

          {/* Native comments stay separate from the existing GitHub discussion. */}
          <div class="my-16">
            <h2 class="text-lg font-semibold mb-4">Native comments</h2>
            <SocialInteractions contentType="post" contentId={post.id} />
          </div>
          <div class="my-16">
            <h2 class="text-lg font-semibold mb-8">GitHub discussion</h2>
            <div class="giscus-wrapper">
              <Giscuss />
            </div>
          </div>
        </div>
      </footer>
    </article>
  </MainContainer>
</BaseLayout>

<style>
  /* Smooth scroll for table of contents */
  html {
    scroll-behavior: smooth;
  }

  /* Style for active ToC link */
  :global(.toc-active) {
    color: var(--primary);
    font-weight: 500;
  }

  .article-reading {
    max-width: 56rem;
  }

  .article-header {
    margin-bottom: var(--space-8);
    padding: var(--space-10) var(--space-6) var(--space-6);
  }

  .article-header-content {
    display: grid;
    gap: var(--space-4);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
  }

  .article-hero {
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-xl);
  }

  .article-contents {
    margin: 0 0 var(--space-8);
    padding: var(--space-4);
    background: var(--card);
    border: var(--rule) solid var(--border);
  }

  .article-contents summary {
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 800;
  }

  .article-contents nav {
    margin-top: var(--space-3);
  }

  .article-contents-rail {
    display: none;
  }

  .article-views {
    min-height: 1.25rem;
  }

  @media (max-width: 47.999rem) {
    .article-header {
      padding: var(--space-8) var(--space-4) var(--space-4);
    }

    .article-header-content {
      gap: var(--space-3);
    }

    .article-header h1 {
      font-size: 2.25rem;
    }

    .article-header p {
      font-size: 1.125rem;
      line-height: 1.55;
    }

    .article-tags {
      gap: var(--space-2);
    }
  }

  /* Add specific styling for giscus wrapper */
  .giscus-wrapper {
    width: 100%;
    margin: 0 auto;
  }

  /* Ensure giscus iframe has proper spacing */
  :global(.giscus-frame) {
    margin-top: 1rem;
  }

  @media (min-width: 48rem) {
    .article-header {
      padding: var(--space-12) var(--space-8) var(--space-8);
    }
  }

  @media (min-width: 80rem) {
    .article-reading {
      max-width: 72rem;
    }

    .article-contents {
      display: none;
    }

    .article-body-layout.has-contents {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 13rem;
      gap: var(--space-8);
      align-items: start;
    }

    .article-body {
      min-width: 0;
      grid-column: 1;
    }

    .article-contents-rail {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 5.5rem;
      display: block;
      max-height: calc(100svh - 7rem);
      overflow-y: auto;
      padding-left: var(--space-3);
      border-left: var(--rule) solid var(--border);
    }
  }
</style>

<script>
  import { initializeArticleReading } from "../../utils/articleReading"

  type ArticleReadingWindow = Window & {
    articleReadingCleanup?: () => void
  }

  const articleReadingWindow = window as ArticleReadingWindow

  const initialize = () => {
    articleReadingWindow.articleReadingCleanup?.()
    articleReadingWindow.articleReadingCleanup = initializeArticleReading()
  }

  window.addEventListener("article-reading:initialize", initialize)
  document.addEventListener("astro:before-swap", () => {
    articleReadingWindow.articleReadingCleanup?.()
    articleReadingWindow.articleReadingCleanup = undefined
  })
  initialize()
</script>

<script is:inline data-astro-rerun>
  window.dispatchEvent(new Event("article-reading:initialize"))
</script>
