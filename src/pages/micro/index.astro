---
import { getCollection, render } from "astro:content"
import MainContainer from "../../components/MainContainer.astro"
import Prose from "../../components/Prose.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"

const allMicro = await getCollection("micro")
const sortedMicro = allMicro
  .filter((micro) => micro.data.published !== false)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const pageTitle = "Micro"
const formatUtcDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", {
    day: "numeric",
    month: "long",
    timeZone: "UTC",
    year: "numeric",
  }).format(date)
---

<BaseLayout
  pageTitle={pageTitle}
  description="Quick thoughts, updates, and shorter musings. Like tweets, but on my own site."
  caption="Short notes"
>
  <MainContainer>
    <div class="micro-archive">
      <section class="panel land micro-feed" style="--i: 0">
        <span class="cap">Archive</span>
        <p>
          <a href="/rss.xml" class="btn-ghost">Blog RSS</a>
          <span>This feed contains blog posts; Micro notes stay on this page.</span>
        </p>
      </section>

      <section class="panel land micro-notes" style="--i: 1">
        <span class="cap">Newest first</span>
        <ol class="rule-list">
        {
          sortedMicro.map(async (micro) => {
            const { Content } = await render(micro)
            return (
              <li>
                <article class="micro-note">
                  <header>
                    <time datetime={micro.data.date.toISOString()} class="meta">
                      {formatUtcDate(micro.data.date)}
                    </time>
                    <a href={`/micro/${micro.id}/`} class="permalink">
                      Permalink
                    </a>
                  </header>

                  <h2>
                    <a href={`/micro/${micro.id}/`} class="link-quiet">
                      {micro.data.title}
                    </a>
                  </h2>

                  <Prose>
                    <Content />
                  </Prose>
                </article>
              </li>
            )
          })
        }
        </ol>
      </section>
    </div>
  </MainContainer>
</BaseLayout>

<style>
  .micro-archive {
    display: grid;
    gap: var(--space-6);
    max-width: 56rem;
  }

  .micro-archive > * {
    min-width: 0;
  }

  .micro-feed {
    padding: var(--space-10) var(--space-6) var(--space-6);
  }

  .micro-feed p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    color: var(--muted-foreground);
  }

  .micro-notes {
    padding: var(--space-10) var(--space-6) var(--space-4);
  }

  .micro-notes ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .micro-note {
    min-width: 0;
    padding: var(--space-6) 0 var(--space-8);
  }

  .micro-note header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .permalink {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .micro-note h2 {
    margin: var(--space-2) 0 var(--space-4);
  }

  .micro-note h2 a {
    display: inline;
  }

  .micro-note :global(.prose > :first-child) {
    margin-top: 0;
  }

  .micro-note :global(.prose) {
    overflow-wrap: anywhere;
  }
</style>
