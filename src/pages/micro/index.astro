---
import { Image } from "astro:assets"
import { getCollection, render } from "astro:content"
import MainContainer from "../../components/MainContainer.astro"
import MarkdownCopy from "../../components/MarkdownCopy.astro"
import Prose from "../../components/Prose.astro"
import SocialInteractions from "../../components/SocialInteractions.astro"
import BK from "../../images/BK.webp"
import BaseLayout from "../../layouts/BaseLayout.astro"

const allMicro = await getCollection("micro")
const sortedMicro = allMicro
  .filter((micro) => micro.data.published !== false)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const pageTitle = "Micro"
const formatUtcDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", {
    day: "numeric",
    month: "long",
    timeZone: "UTC",
    year: "numeric",
  }).format(date)
---

<BaseLayout
  pageTitle={pageTitle}
  description="Quick thoughts, updates, and shorter musings. Like tweets, but on my own site."
  caption="Short notes"
>
  <MainContainer>
    <div class="micro-archive">
      <section class="panel land micro-notes" style="--i: 0">
        <span class="cap">Newest first</span>
          <ol class="micro-stream">
        {
          sortedMicro.map(async (micro) => {
            const { Content } = await render(micro)
            return (
              <li>
                <article class="micro-note">
                  <header class="micro-author">
                    <Image src={BK} alt="" width={40} height={40} loading="lazy" />
                    <div>
                      <strong>Bhekani Khumalo</strong>
                      <time datetime={micro.data.date.toISOString()} class="meta">
                        {formatUtcDate(micro.data.date)}
                      </time>
                    </div>
                    <a href={`/micro/${micro.id}/`} class="permalink">
                      Permalink
                    </a>
                    <MarkdownCopy markdownUrl={`/micro/${micro.id}.md`} compact />
                  </header>

                  {micro.data.title?.trim() && <h2><a href={`/micro/${micro.id}/`} class="link-quiet">{micro.data.title.trim()}</a></h2>}

                  <Prose>
                    <Content />
                  </Prose>
                  <SocialInteractions contentType="micro" contentId={micro.id} />
                </article>
              </li>
            )
          })
        }
        </ol>
      </section>

      <aside class="micro-feed" aria-label="Blog feed">
        <a href="/rss.xml" class="btn-ghost">Blog RSS</a>
        <span>This feed contains blog posts; Micro notes stay on this page.</span>
      </aside>
    </div>
  </MainContainer>
</BaseLayout>

<style>
  .micro-archive {
    display: grid;
    gap: var(--space-6);
    max-width: 56rem;
  }

  .micro-archive > * {
    min-width: 0;
  }

  .micro-feed {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: 0 var(--space-2) var(--space-4);
    color: var(--muted-foreground);
  }

  .micro-notes {
    padding: var(--space-10) var(--space-6) var(--space-4);
  }

  .micro-stream {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .micro-stream > li + li .micro-note {
    border-top: 1px solid var(--border);
  }

  .micro-note {
    min-width: 0;
    padding: var(--space-6) 0 var(--space-8);
  }

  .micro-author {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .micro-author img {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: cover;
    border-radius: 999px;
    border: 1px solid var(--border);
  }

  .micro-author div { display: grid; gap: 0.125rem; }

  .micro-author .permalink { margin-left: auto; }
  .micro-author :global(.markdown-copy) { gap: var(--space-2); }

  .permalink {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .micro-note h2 {
    margin: var(--space-2) 0 var(--space-4);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
  }

  .micro-note h2 a {
    display: inline;
  }

  .micro-note :global(.prose > :first-child) {
    margin-top: 0;
  }

  .micro-note :global(.prose) {
    overflow-wrap: anywhere;
  }
</style>
