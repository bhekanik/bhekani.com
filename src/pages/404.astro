---
import MainContainer from "../components/MainContainer.astro"
import BaseLayout from "../layouts/BaseLayout.astro"

const pageTitle = "Page not found"
---

<BaseLayout pageTitle={pageTitle} hidePageHeader={true}>
  <MainContainer>
    <div class="panel dots screen land">
      <span class="cap">Game over</span>
      <p class="code">404</p>
      <h1>Continue?</h1>
      <p class="copy">The link is wrong or the page moved. The search in the header covers every post, book and project.</p>
      <p class="actions">
        <a href="/" class="btn">Yes</a>
        <a href="/posts" class="btn-ghost">Read something instead</a>
      </p>
      <p class="countdown meta" aria-hidden="true">9… 8… 7…</p>
    </div>
  </MainContainer>
</BaseLayout>

<style>
  .screen {
    margin-top: var(--space-10);
    padding: var(--space-12) var(--space-8);
    max-width: 52rem;
  }
  .code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 20vw, 11rem);
    line-height: 0.85;
    color: var(--accent);
    margin: 0 0 var(--space-2);
  }
  h1 {
    margin: 0 0 var(--space-4);
  }
  .copy {
    max-width: 48ch;
    margin: 0 0 var(--space-6);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0 0 var(--space-6);
  }
  .countdown {
    margin: 0;
    font-family: var(--font-mono);
  }
</style>
