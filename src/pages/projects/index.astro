---
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import MainContainer from "../../components/MainContainer.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"

const allProjects = await getCollection("projects")
const sortedProjects = allProjects
  .filter((project) => project.data.published)
  .sort((a, b) => new Date(b.data.startDate).valueOf() - new Date(a.data.startDate).valueOf())

const featuredProjects = sortedProjects.filter((project) => project.data.featured)
const otherProjects = sortedProjects.filter((project) => !project.data.featured)

const pageTitle = "Projects"
const description = "Things I've built outside work. The three at the top are what I'm working on now."
---

<BaseLayout pageTitle={pageTitle} description={description}>
  <MainContainer>
    <section class="featured">
      {
        featuredProjects.map((project, index) => (
          <article class="feature" style={`--i: ${index}`}>
            <a href={project.data.url} class="shot" aria-label={`Open ${project.data.title}`}>
              {project.data.image && (
                <Image
                  src={project.data.image}
                  alt={`Screenshot of ${project.data.title}`}
                  width={1280}
                  height={800}
                  loading={index === 0 ? "eager" : "lazy"}
                />
              )}
            </a>
            <div class="feature-body">
              <h2>
                <a href={project.data.url}>{project.data.title}</a>
              </h2>
              <p>{project.data.description}</p>
              <p class="feature-links">
                <a href={project.data.url} class="btn">
                  Visit site
                </a>
                {project.data.appStoreUrl && (
                  <a href={project.data.appStoreUrl} class="btn-ghost">
                    App Store
                  </a>
                )}
              </p>
              <ul class="tech">
                {project.data.tech.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </section>

    {
      otherProjects.length > 0 && (
        <section class="others">
          <h2>Earlier</h2>
          <ul class="rule-list">
            {otherProjects.map((project) => (
              <li>
                <a href={project.data.url} class="project-name">
                  {project.data.title}
                </a>
                <span class="meta">{new Date(project.data.startDate).getFullYear()}</span>
                <p>{project.data.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </MainContainer>
</BaseLayout>

<style>
  .featured {
    display: grid;
    gap: var(--space-16);
    margin-top: var(--space-4);
  }

  .feature {
    display: grid;
    gap: var(--space-6);
  }

  /* Screenshot sits on an oxide slab, offset to alternate sides per project */
  .shot {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
  }
  .shot::before {
    content: "";
    position: absolute;
    inset: 0;
    translate: 0.875rem 0.875rem;
    background: var(--accent);
    border-radius: var(--radius-lg);
    transition: translate var(--transition-slow);
  }
  .feature:nth-child(even) .shot::before {
    translate: -0.875rem 0.875rem;
  }
  .shot:hover::before {
    translate: 0.5rem 0.5rem;
  }
  .feature:nth-child(even) .shot:hover::before {
    translate: -0.5rem 0.5rem;
  }
  .shot img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .feature-body h2 {
    margin: 0 0 var(--space-3);
  }
  .feature-body h2 a {
    color: inherit;
    text-decoration: none;
  }
  .feature-body h2 a:hover {
    color: var(--links);
  }
  .feature-body > p {
    margin: 0 0 var(--space-5);
    max-width: 60ch;
  }
  .feature-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  .others {
    margin-top: var(--space-16);
  }
  .others h2 {
    margin: 0 0 var(--space-6);
  }
  .rule-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .rule-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-4);
    padding: var(--space-4) 0;
  }
  .rule-list li + li {
    border-top: 1px solid var(--border);
  }
  .rule-list p {
    grid-column: 1 / -1;
    margin: var(--space-1) 0 0;
    color: var(--muted-foreground);
    font-size: 1rem;
  }
  .project-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-variation-settings: "wdth" 105;
    font-size: 1.125rem;
    color: var(--foreground);
    text-decoration: none;
  }
  .project-name:hover {
    color: var(--links);
  }

  @media (min-width: 48rem) {
    .feature {
      grid-template-columns: 3fr 2fr;
      align-items: center;
      gap: var(--space-10);
    }
    .feature:nth-child(even) .shot {
      order: 2;
    }
  }
</style>
