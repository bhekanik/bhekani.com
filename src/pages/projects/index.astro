---
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import MainContainer from "../../components/MainContainer.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"

const allProjects = await getCollection("projects")
const sortedProjects = allProjects
  .filter((project) => project.data.published)
  .sort((a, b) => new Date(b.data.startDate).valueOf() - new Date(a.data.startDate).valueOf())

const featuredProjects = sortedProjects.filter((project) => project.data.featured)
const otherProjects = sortedProjects.filter((project) => !project.data.featured)

const pageTitle = "Projects"
const description = "Things I've built outside work. The three at the top are what I'm working on now."
const issueNumber = (date: string) => new Date(date).getFullYear()
---

<BaseLayout pageTitle={pageTitle} description={description} caption="Now showing">
  <MainContainer>
    <section class="covers">
      {
        featuredProjects.map((project, index) => (
          <article class="panel cover land" style={`--i: ${index}`}>
            <span class="cap">Issue #{issueNumber(project.data.startDate)}</span>
            {project.data.appStoreUrl && <span class="burst">Now on iOS</span>}
            <a href={project.data.url} class="shot" aria-label={`Open ${project.data.title}`}>
              {project.data.image && (
                <Image
                  src={project.data.image}
                  alt={`Screenshot of ${project.data.title}`}
                  width={1280}
                  height={800}
                  loading={index === 0 ? "eager" : "lazy"}
                />
              )}
            </a>
            <div class="cover-body">
              <h2>
                <a href={project.data.url}>{project.data.title}</a>
              </h2>
              <p>{project.data.description}</p>
              <p class="cover-links">
                <a href={project.data.url} class="btn">
                  Visit site
                </a>
                {project.data.appStoreUrl && (
                  <a href={project.data.appStoreUrl} class="btn-ghost">
                    App Store
                  </a>
                )}
              </p>
              <ul class="tech">
                {project.data.tech.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </section>

    {
      otherProjects.length > 0 && (
        <section class="panel back-issues land" style="--i: 3">
          <span class="cap">Back issues</span>
          <ul class="rule-list">
            {otherProjects.map((project) => (
              <li>
                <a href={project.data.url} class="project-name">
                  {project.data.title}
                </a>
                <span class="meta">{issueNumber(project.data.startDate)}</span>
                <p>{project.data.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </MainContainer>
</BaseLayout>

<style>
  .covers {
    display: grid;
    gap: var(--space-8);
  }

  .cover {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-10) var(--space-6) var(--space-6);
  }
  .cover .burst {
    position: absolute;
    top: -1.5rem;
    right: -1rem;
    z-index: 1;
  }
  :global(html[data-skin="route"]) .cover .burst {
    top: var(--space-4);
    right: var(--space-4);
  }

  .shot {
    display: block;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: var(--rule) solid var(--border);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .shot:hover img {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-ink);
  }

  .cover-body h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .cover-body h2 a {
    color: inherit;
    text-decoration: none;
  }
  .cover-body h2 a:hover {
    color: var(--links);
  }
  .cover-body > p {
    margin: 0 0 var(--space-5);
    max-width: 60ch;
  }
  .cover-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  .back-issues {
    margin-top: var(--space-10);
    padding: var(--space-10) var(--space-6) var(--space-6);
  }
  .rule-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rule-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-4);
    padding: var(--space-4) 0;
  }
  .rule-list p {
    grid-column: 1 / -1;
    margin: var(--space-1) 0 0;
    color: var(--muted-foreground);
    font-size: 1rem;
  }
  .project-name {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.125rem;
    color: var(--foreground);
    text-decoration: none;
  }
  .project-name:hover {
    color: var(--links);
  }

  @media (min-width: 48rem) {
    .cover {
      grid-template-columns: 3fr 2fr;
      align-items: center;
      gap: var(--space-8);
    }
    .cover:nth-child(even) .shot {
      order: 2;
    }
  }
</style>
