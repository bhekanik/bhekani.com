---
import { getCollection, type CollectionEntry } from "astro:content"
import AllBookTags from "../../../components/AllBookTags.astro"
import BookListItem from "../../../components/BookListItem.astro"
import MainContainer from "../../../components/MainContainer.astro"
import BaseLayout from "../../../layouts/BaseLayout.astro"
import { getBookTags } from "../../../utils/library"

export async function getStaticPaths() {
  const books = await getCollection("books")
  const readBooks = books.filter((book) => book.data.exclusiveShelf === "read")

  const uniqueTags = getBookTags(readBooks.map((book) => ({ ...book.data, ...book })))

  return uniqueTags.map((tag) => {
    const filteredBooks = readBooks.filter((book) => book.data.tags.includes(tag))
    return {
      params: { tag },
      props: { books: filteredBooks },
    }
  })
}

export interface Props {
  books: CollectionEntry<"books">[]
}

const { tag } = Astro.params
const { books } = Astro.props
---

<BaseLayout pageTitle={`Books: #${tag}`}>
  <MainContainer>
    <div class="w-full flex justify-center mb-8 font-bold">
      <a
        class="px-3 p-2 text-foreground border-b-[1px] border-l-[1px] border-r-[1px] border-muted"
        href="/books/"
      >
        Back to library
      </a>
    </div>

    <AllBookTags title="Filter books by tag" selectedTag={tag} />
    <h2 class="text-2xl mb-4 mt-2">
      Books tagged with "{tag}"
    </h2>
    <ul class="flex flex-col gap-8">
      {books.map((book) => <BookListItem book={book} />)}
    </ul>
  </MainContainer>
</BaseLayout>
