{
  "name": "bhekani.com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "lint": "astro check",
    "generate:search-index": "bun run scripts/generate-search-index.ts",
    "generate:embeddings": "bun run scripts/generate-embeddings.ts",
    "prebuild": "rm -rf node_modules/.astro && bun run generate:search-index && bun run generate:embeddings",
    "build": "bun run lint && astro sync && astro build --remote",
    "verify:offline": "rm -f .astro/verify.db && ASTRO_TELEMETRY_DISABLED=1 VERIFY_OFFLINE=1 ASTRO_DATABASE_FILE=.astro/verify.db bun run test --run && ASTRO_TELEMETRY_DISABLED=1 VERIFY_OFFLINE=1 ASTRO_DATABASE_FILE=.astro/verify.db bun run lint && ASTRO_TELEMETRY_DISABLED=1 VERIFY_OFFLINE=1 ASTRO_DATABASE_FILE=.astro/verify.db astro sync && ASTRO_TELEMETRY_DISABLED=1 VERIFY_OFFLINE=1 ASTRO_DATABASE_FILE=.astro/verify.db astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/db": "0.21.3",
    "@astrojs/mdx": "7.0.6",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/svelte": "9.0.1",
    "@astrojs/vercel": "11.0.7",
    "@astrolib/seo": "1.0.0-beta.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@sentry/astro": "^10.43.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/mdast": "4.0.4",
    "@upstash/vector": "^1.2.2",
    "astro": "7.3.1",
    "astro-embed": "^0.13.0",
    "astro-expressive-code": "^0.44.1",
    "astro-og-canvas": "^0.13.0",
    "astro-robots-txt": "^1.0.0",
    "canvaskit-wasm": "^0.42.0",
    "case": "^1.6.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-mdxjs-esm": "2.0.1",
    "openai": "^7.5.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "sharp": "^0.35.1",
    "string-width": "^8.1.0",
    "svelte": "^5.46.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "unified": "11.0.5",
    "web-haptics": "0.0.6",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/ui": "^4.0.18",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "vitest": "^4.0.18"
  },
  "trustedDependencies": [
    "@sentry/cli"
  ],
  "overrides": {}
}
