{
  "name": "bhekani.com",
  "type": "module",
  "version": "0.40.11",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "lint": "astro check",
    "generate:embeddings": "bun run scripts/generate-embeddings.ts",
    "prebuild": "rm -rf node_modules/.astro && bun run generate:embeddings",
    "verify:node-runtime": "node -e \"const [major, minor] = process.versions.node.split('.').map(Number); if (major !== 22 || minor < 19) throw new Error('Node 22.19 or later is required'); console.log('Node runtime ' + process.version + ' satisfies >=22.19.0 <23');\"",
    "build": "bun run verify:node-runtime && bun run lint && astro sync && astro build --remote",
    "verify:offline": "bun run verify:node-runtime && rm -f .astro/verify.db && ASTRO_TELEMETRY_DISABLED=1 VERIFY_OFFLINE=1 ASTRO_DATABASE_FILE=.astro/verify.db bun run test --run && ASTRO_TELEMETRY_DISABLED=1 VERIFY_OFFLINE=1 ASTRO_DATABASE_FILE=.astro/verify.db bun run lint && ASTRO_TELEMETRY_DISABLED=1 VERIFY_OFFLINE=1 ASTRO_DATABASE_FILE=.astro/verify.db astro sync && ASTRO_TELEMETRY_DISABLED=1 VERIFY_OFFLINE=1 ASTRO_DATABASE_FILE=.astro/verify.db astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/db": "0.21.3",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/svelte": "9.0.1",
    "@astrojs/vercel": "11.0.16",
    "@astrolib/seo": "1.0.0-beta.8",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/anton": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@libsql/client": "0.17.4",
    "@sentry/astro": "10.76.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdast": "4.0.4",
    "@upstash/vector": "1.2.3",
    "astro": "7.3.3",
    "astro-embed": "0.14.0",
    "astro-expressive-code": "0.44.3",
    "astro-og-canvas": "0.13.2",
    "astro-robots-txt": "1.0.0",
    "canvaskit-wasm": "0.42.0",
    "case": "1.6.3",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "gray-matter": "4.0.3",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-mdxjs-esm": "2.0.1",
    "openai": "7.43.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "string-width": "8.3.0",
    "svelte": "5.57.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "web-haptics": "0.0.6",
    "wrap-ansi": "10.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@vitest/ui": "5.0.5",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "vitest": "5.0.5"
  },
  "trustedDependencies": [
    "@sentry/cli"
  ],
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "overrides": {}
}
